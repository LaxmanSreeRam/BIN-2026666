# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------
# Dedicated Multi-Email Gmail Configuration
# Each email address handles a specific platform function.
# Generate 16-character App Passwords from Google Account:
# https://myaccount.google.com/apppasswords
# -------------------------------------------------------------

# 1. Support & Issue Reporting (Receives bug reports and sends support notifications)
SUPPORT_GMAIL_USER="verdetech001@gmail.com"
SUPPORT_GMAIL_APP_PASSWORD=

# 2. Credentials Dispatch (Sends student Eco Numbers and account passwords)
CREDENTIALS_GMAIL_USER="credentialsverdetech@gmail.com"
CREDENTIALS_GMAIL_APP_PASSWORD=

# 3. Verification Codes (Sends 6-digit registration and phone verification codes)
VERIFY_GMAIL_USER="verifyverdetechsystems@gmail.com"
VERIFY_GMAIL_APP_PASSWORD=

# Optional: Global fallback App Password if you prefer using a single password
GMAIL_APP_PASSWORD=
